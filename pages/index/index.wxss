.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
}

.dice-area {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dice-list {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.die {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: 2rpx solid currentColor;
  border-radius: 12rpx;
}

.cover,
.primary-action {
  width: 100%;
}

.hint {
  margin: 32rpx 0;
  text-align: center;
}
