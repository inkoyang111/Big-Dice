.page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  overflow: hidden;
  background: #120805;
  font-family: STKaiti, KaiTi, FangSong, serif;
}

.background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.game-stage {
  position: relative;
  z-index: 1;
  width: 750rpx;
  height: 1210rpx;
}

.medallion {
  position: absolute;
  z-index: 1;
  top: 790rpx;
  left: 45rpx;
  width: 660rpx;
  opacity: 0.43;
}

.cover-hit-area {
  position: absolute;
  z-index: 5;
  inset: 0;
}

.cup {
  position: absolute;
  display: block;
  filter: drop-shadow(0 22rpx 18rpx rgba(0, 0, 0, 0.48));
  transform-origin: 50% 82%;
}

.cup--closed {
  top: 570rpx;
  left: 160rpx;
  width: 430rpx;
}

.cup--rolling {
  animation: cup-shake 180ms ease-in-out infinite alternate;
}

.page--ready .cup--closed {
  animation: cup-ready 520ms ease-out 1;
}

.cup--open {
  top: 515rpx;
  left: 410rpx;
  width: 300rpx;
  transform: rotate(3deg);
  animation: cup-open 360ms cubic-bezier(0.2, 0.85, 0.35, 1) both;
}

.open-set {
  position: absolute;
  z-index: 3;
  inset: 0;
}

.tray {
  position: absolute;
  top: 905rpx;
  left: 105rpx;
  width: 540rpx;
  filter: drop-shadow(0 22rpx 18rpx rgba(0, 0, 0, 0.52));
  animation: tray-enter 260ms ease-out both;
}

.die {
  position: absolute;
  z-index: 4;
  width: 92rpx;
  filter: drop-shadow(0 12rpx 8rpx rgba(0, 0, 0, 0.46));
  animation: dice-enter 280ms ease-out both;
}

.die--0 {
  top: 960rpx;
  left: 190rpx;
  transform: rotate(-16deg);
}

.die--1 {
  top: 915rpx;
  left: 321rpx;
  transform: rotate(7deg);
}

.die--2 {
  top: 966rpx;
  left: 460rpx;
  transform: rotate(16deg);
}

.die--3 {
  top: 1048rpx;
  left: 270rpx;
  transform: rotate(-8deg);
}

.die--4 {
  top: 1030rpx;
  left: 403rpx;
  transform: rotate(10deg);
}

.cover-hint {
  position: absolute;
  z-index: 7;
  color: #d9b56b;
  font-family: STKaiti, KaiTi, FangSong, serif;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9);
  white-space: nowrap;
}

.cover-hint--open {
  top: 600rpx;
  right: 30rpx;
}

.cover-hint--close {
  top: 440rpx;
  right: 30rpx;
}

.primary-action {
  position: absolute;
  z-index: 10;
  top: 1240rpx;
  left: 100rpx;
  width: 580rpx;
  height: 132rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 40rpx;
  overflow: visible;
  background: transparent;
  line-height: normal;
}

.primary-action::after {
  border: 0;
}

.primary-action__base {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.primary-action__label {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  height: 114rpx;
  align-items: center;
  justify-content: center;
  color: #fff0c9;
  font-size: 56rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
  text-shadow: 0 3rpx 3rpx rgba(86, 12, 7, 0.75);
}

.primary-action--pressed {
  transform: translateY(7rpx);
  filter: brightness(0.88);
}

@keyframes cup-shake {
  from {
    transform: translate3d(-10rpx, 2rpx, 0) rotate(-2.2deg);
  }
  to {
    transform: translate3d(10rpx, -3rpx, 0) rotate(2.2deg);
  }
}

@keyframes cup-ready {
  0%, 100% {
    transform: translateY(0);
  }
  52% {
    transform: translateY(-18rpx);
  }
}

@keyframes cup-open {
  from {
    opacity: 0;
    transform: translate(-175rpx, 245rpx) rotate(-16deg) scale(1.18);
  }
  to {
    opacity: 1;
    transform: translate(0, 0) rotate(3deg) scale(1);
  }
}

@keyframes tray-enter {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes dice-enter {
  from {
    opacity: 0;
    margin-top: -15rpx;
  }
  to {
    opacity: 1;
    margin-top: 0;
  }
}

@media (max-height: 720px) {
  .game-stage {
    transform: translateY(-70rpx) scale(0.94);
    transform-origin: top center;
  }

  .primary-action {
    top: auto;
    bottom: calc(env(safe-area-inset-bottom) + 34rpx);
  }
}
